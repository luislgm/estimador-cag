# API keys (solo es obligatoria la del proveedor que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor: openai | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# Aplicación
APP_ENV=development
LOG_LEVEL=DEBUG

# Trazas en Arize Phoenix (opcional). Vacío = desactivado.
# Con docker compose, Phoenix escucha en http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=estimador-cag

# Caché exact-match en Redis (opcional). Vacío = desactivada.
# Con docker compose, Redis escucha en 127.0.0.1:6379 (mejor que "localhost" en Windows)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL=86400

# URL del servicio IA que usa el cliente Streamlit
ESTIMATOR_API_URL=http://127.0.0.1:8000
