# API keys (solo es obligatoria la del proveedor que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor: openai | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# Aplicación
APP_ENV=development
LOG_LEVEL=DEBUG

# Trazas en Arize Phoenix (opcional). Vacío = desactivado.
# Con docker compose, Phoenix escucha en http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=estimador-cag
